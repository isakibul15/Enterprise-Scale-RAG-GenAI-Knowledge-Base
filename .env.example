# ============================================================
# Environment Configuration — copy to .env and fill in values
# ============================================================

# --- Application ---
APP_ENV=development                  # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Vector Database (ChromaDB) ---
# ChromaDB runs embedded — no separate server process required.
# Data is persisted to CHROMA_PERSIST_DIR automatically.
CHROMA_PERSIST_DIR=./storage/chroma
COLLECTION_NAME=knowledge_base

# --- Embedding Model ---
# HuggingFace model name — pulled on first run and cached locally
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # 384-dim, fast; swap for bge-large-en-v1.5 for higher accuracy
EMBEDDING_DEVICE=cpu               # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32

# --- LLM Backend ---
# Options: openai | azure_openai | ollama
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1                 # model tag used by the chosen provider

# OpenAI / Azure OpenAI (only required when LLM_PROVIDER=openai|azure_openai)
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_DEPLOYMENT=

# Ollama (only required when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval ---
RETRIEVER_TOP_K=6
PARENT_CHUNK_SIZE=2048             # parent doc size for ParentDocumentRetriever

# --- Storage ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
